# Settings for the LOCAL environment. Copy to src/.env, or run
#   python infrastructure/setup_local.py
# which makes one with fresh made-up keys. Never commit src/.env.
# On Parks IT's servers these come from their secret store instead
# (docs/d08-02-developer-guide.md Section 5).
DATABASE_URL=sqlite:///bbpv-local.db
SECRET_KEY=replace-me
EMAIL_ENCRYPTION_KEY=replace-me
BASE_URL=http://localhost:5000
EMAIL_SERVICE=pretend
FORCE_HTTPS=false
